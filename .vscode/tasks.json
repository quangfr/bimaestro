{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Live Server",
      "type": "shell",
      "command": "npx -y live-server --port=8080 --no-browser --entry-file=index.html --watch=index.html,content.md,readme.md,gouvernance.md,js/**,*.json",
      "isBackground": true,
      "problemMatcher": {
        "pattern": [
          {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Serving \".*\" at http://.*"
        }
      }
    }
  ]
}
